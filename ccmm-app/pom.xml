<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>dev.bilal.ccmm</groupId><artifactId>ccmm-ide-parent</artifactId><version>${revision}</version><relativePath>../pom.xml</relativePath></parent>
  <artifactId>ccmm-app</artifactId>
  <name>CCMM IDE app</name>
  <dependencies>
    <dependency><groupId>dev.bilal.ccmm</groupId><artifactId>ccmm-core</artifactId></dependency>
    <dependency><groupId>dev.bilal.ccmm</groupId><artifactId>ccmm-collab-protocol</artifactId></dependency>
    <dependency><groupId>org.openjfx</groupId><artifactId>javafx-controls</artifactId><version>${javafx.version}</version></dependency>
    <dependency><groupId>org.fxmisc.richtext</groupId><artifactId>richtextfx</artifactId><version>0.11.2</version></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-dependency-plugin</artifactId><version>3.8.1</version>
        <executions>
          <execution>
            <phase>package</phase><goals><goal>copy-dependencies</goal></goals>
            <configuration><outputDirectory>${project.build.directory}/libs</outputDirectory><includeScope>runtime</includeScope></configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.openjfx</groupId><artifactId>javafx-maven-plugin</artifactId><version>0.0.8</version>
        <configuration><mainClass>dev.bilal.ccmm.app.Main</mainClass></configuration>
      </plugin>
    </plugins>
  </build>
</project>
